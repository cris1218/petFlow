generator client {
  provider = "prisma-client-js"
}

// PostgreSQL no Supabase: DATABASE_URL = pooler transacional (6543)
// e DIRECT_URL = conexão direta/session (5432) para prisma db push.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  MASTER
  ADMIN
  STAFF
}

enum PetSpecies {
  DOG
  CAT
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum VaccineStatus {
  VALID
  EXPIRED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum SupportTicketStatus {
  OPEN
  WAITING_HOTEL
  WAITING_MASTER
  CLOSED
}

enum ServiceKind {
  STAY
  APPOINTMENT
}

// ---------------------------------------------------------------------------
// Tenant (estabelecimento)
// ---------------------------------------------------------------------------

model Tenant {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  whatsappNumber       String?
  whatsappInstanceName String?      @unique
  whatsappConnected    Boolean      @default(false)
  mpAccessTokenEnc     String?
  logoUrl              String?
  hotelRate            Decimal      @default(80) @db.Decimal(10, 2)
  daycareRate          Decimal      @default(50) @db.Decimal(10, 2)
  groomingRate         Decimal      @default(70) @db.Decimal(10, 2)
  depositRate          Decimal      @default(0.30) @db.Decimal(4, 2)
  stayCapacity         Int          @default(10)
  appointmentCapacity  Int          @default(1)
  slotDurationMin      Int          @default(60)
  billingPaidUntil     DateTime?
  status               TenantStatus @default(TRIAL)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  users                 User[]
  tutors                Tutor[]
  pets                  Pet[]
  vaccines              Vaccine[]
  bookings              Booking[]
  dailyLogs             DailyLog[]
  checklistItems        ChecklistItem[]
  supportTickets        SupportTicket[]
  subscriptionPayments  SubscriptionPayment[]
  services              TenantService[]
  belongings            TenantBelonging[]
  requiredVaccines      TenantRequiredVaccine[]
  weekdays              TenantWeekday[]

  @@index([status])
}

model TenantBelonging {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantRequiredVaccine {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model TenantService {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  price     Decimal     @db.Decimal(10, 2)
  kind      ServiceKind @default(STAY)
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([tenantId, active])
}

model TenantWeekday {
  id        String  @id @default(cuid())
  tenantId  String
  weekday   Int
  openTime  String  @default("08:00")
  closeTime String  @default("18:00")
  closed    Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, weekday])
  @@index([tenantId])
}

model PlatformSettings {
  id               String   @id @default("platform")
  mpAccessTokenEnc String?
  updatedAt        DateTime @updatedAt
}

model SubscriptionPayment {
  id           String        @id @default(cuid())
  tenantId     String
  amount       Decimal       @db.Decimal(10, 2)
  daysGranted  Int           @default(30)
  mpPaymentId  String?       @unique
  qrCode       String?
  qrCodeBase64 String?
  status       PaymentStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  paidAt       DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model Lead {
  id        String   @id @default(cuid())
  hotelName String
  city      String
  phone     String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketsOpened SupportTicket[] @relation("TicketAuthor")
  supportMessages SupportMessage[] @relation("MessageAuthor")

  @@index([tenantId])
}

model SupportTicket {
  id        String              @id @default(cuid())
  tenantId  String
  authorId  String
  subject   String
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author   User             @relation("TicketAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  messages SupportMessage[]

  @@index([tenantId, status])
  @@index([updatedAt])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String
  body       String
  fromMaster Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId])
}

model Tutor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  cpf       String?
  address   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pets   Pet[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Pet {
  id        String     @id @default(cuid())
  tenantId  String
  tutorId   String
  name      String
  species   PetSpecies
  breed     String?
  size      PetSize
  birthDate DateTime?
  notes     String?
  createdAt DateTime   @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor    Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  vaccines Vaccine[]
  bookings Booking[]

  @@index([tenantId])
  @@index([tutorId])
}

model Vaccine {
  id              String         @id @default(cuid())
  tenantId        String
  petId           String
  name            String
  applicationDate DateTime?
  expirationDate  DateTime?
  status          VaccineStatus  @default(VALID)
  createdAt       DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([petId])
  @@index([expirationDate])
}

model Booking {
  id            String         @id @default(cuid())
  tenantId      String
  petId         String
  serviceId     String?
  serviceType   String
  startDate     DateTime
  endDate       DateTime
  slotTime      String?
  status        BookingStatus  @default(PENDING)
  totalAmount   Decimal        @db.Decimal(10, 2)
  depositAmount Decimal        @db.Decimal(10, 2)
  paymentStatus PaymentStatus  @default(PENDING)
  mpPaymentId   String?        @unique
  reminderSent  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Restrict)
  service        TenantService?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  dailyLogs      DailyLog[]
  checklistItems ChecklistItem[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@index([tenantId, slotTime, startDate])
  @@index([petId])
  @@index([serviceId])
}

model DailyLog {
  id             String   @id @default(cuid())
  tenantId       String
  bookingId      String
  photoUrl       String
  statusNote     String
  sentToWhatsApp Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}

model ChecklistItem {
  id                 String  @id @default(cuid())
  tenantId           String
  bookingId          String
  itemName           String
  quantity           Int     @default(1)
  returnedOnCheckout Boolean @default(false)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}
