generator client {
  provider = "prisma-client-js"
}

// PostgreSQL no Supabase: DATABASE_URL = pooler transacional (6543)
// e DIRECT_URL = conexão direta/session (5432) para prisma db push.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserRole {
  ADMIN
  STAFF
}

enum PetSpecies {
  DOG
  CAT
  OTHER
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum VaccineStatus {
  VALID
  EXPIRED
}

enum ServiceType {
  HOTEL
  DAYCARE
  GROOMING
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

// ---------------------------------------------------------------------------
// Tenant (estabelecimento)
// ---------------------------------------------------------------------------

model Tenant {
  id                   String       @id @default(cuid())
  name                 String
  slug                 String       @unique
  whatsappNumber       String?
  whatsappInstanceName String?      @unique
  whatsappConnected    Boolean      @default(false)
  mpAccessTokenEnc     String?
  hotelRate            Decimal      @default(80) @db.Decimal(10, 2)
  daycareRate          Decimal      @default(50) @db.Decimal(10, 2)
  groomingRate         Decimal      @default(70) @db.Decimal(10, 2)
  depositRate          Decimal      @default(0.30) @db.Decimal(4, 2)
  status               TenantStatus @default(TRIAL)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  users          User[]
  tutors         Tutor[]
  pets           Pet[]
  vaccines       Vaccine[]
  bookings       Booking[]
  dailyLogs      DailyLog[]
  checklistItems ChecklistItem[]

  @@index([status])
}

model Lead {
  id        String   @id @default(cuid())
  hotelName String
  city      String
  phone     String
  email     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Tutor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  cpf       String?
  address   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pets   Pet[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

model Pet {
  id        String     @id @default(cuid())
  tenantId  String
  tutorId   String
  name      String
  species   PetSpecies
  breed     String?
  size      PetSize
  birthDate DateTime?
  notes     String?
  createdAt DateTime   @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tutor    Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  vaccines Vaccine[]
  bookings Booking[]

  @@index([tenantId])
  @@index([tutorId])
}

model Vaccine {
  id              String        @id @default(cuid())
  tenantId        String
  petId           String
  name            String
  applicationDate DateTime
  expirationDate  DateTime
  status          VaccineStatus
  createdAt       DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([petId])
  @@index([expirationDate])
}

model Booking {
  id            String         @id @default(cuid())
  tenantId      String
  petId         String
  serviceType   ServiceType
  startDate     DateTime
  endDate       DateTime
  status        BookingStatus  @default(PENDING)
  totalAmount   Decimal        @db.Decimal(10, 2)
  depositAmount Decimal        @db.Decimal(10, 2)
  paymentStatus PaymentStatus  @default(PENDING)
  mpPaymentId   String?        @unique
  reminderSent  Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Restrict)
  dailyLogs      DailyLog[]
  checklistItems ChecklistItem[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@index([petId])
}

model DailyLog {
  id             String   @id @default(cuid())
  tenantId       String
  bookingId      String
  photoUrl       String
  statusNote     String
  sentToWhatsApp Boolean  @default(false)
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}

model ChecklistItem {
  id                 String  @id @default(cuid())
  tenantId           String
  bookingId          String
  itemName           String
  quantity           Int     @default(1)
  returnedOnCheckout Boolean @default(false)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([bookingId])
}
